# Aegis Campus - Variables de Entorno de Ejemplo (Backend)
# Copiar este archivo a .env y configurar los valores pertinentes para el entorno

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Puerto del servidor backend Express
PORT=3000

# Cadena de conexión a PostgreSQL (compatible con Neon, Supabase, RDS, local)
# En producción o cuando la URL contiene 'sslmode=require', se activa SSL automáticamente.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_base_datos?sslmode=require

# Clave secreta administrativa para proteger el endpoint de reinicio del tablero (/api/v1/expo/reset)
ADMIN_RESET_KEY=tu_clave_secreta_aqui

# Orígenes permitidos para solicitudes HTTP (CORS) y conexiones de Socket.io (* para todos)
ALLOWED_ORIGIN=*

# Variables adicionales de configuración
# Configuración alternativa de CORS
CORS_ORIGIN=*

# Límite de tasa para reportes de incidentes (express-rate-limit)
RATE_LIMIT_WINDOW_MS=180000
RATE_LIMIT_MAX_REQUESTS=10

# Configuración de Logs y Debugging
LOG_LEVEL=info

# Secreto criptográfico para firma de Gafetes Digitales (JWT)
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui

# Configuración de Notificaciones por Correo Electrónico (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion
EMAIL_DESTINOS=director@uvm.edu.mx, seguridad@uvm.edu.mx
